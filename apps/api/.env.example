# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# ---- dev DB setup (node scripts/setup-dev-db.mjs) ----
# Ubuntu SQL Server host (host or host:port). SQL_ADMIN_PASSWORD is used once and cleared by the script.
DB_HOST=
SQL_ADMIN_USER=sa
SQL_ADMIN_PASSWORD=
# Password for the serviceflow_dev login the script creates:
# node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
DEV_DB_PASSWORD=

# Filled by the setup script. Prisma URL format:
# sqlserver://HOST:1433;database=serviceflow_dev;user=serviceflow_dev;password={PASSWORD};encrypt=true;trustServerCertificate=true
DATABASE_URL=
# Separate database used by integration tests (wiped between tests; name must contain "test").
DATABASE_URL_TEST=

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Public URL that users open (Cloudflare Tunnel hostname in production).
APP_URL=http://localhost:5173
COOKIE_SECURE=false
# Trust X-Forwarded-For / CF-Connecting-IP from the tunnel.
TRUST_PROXY=false

# SMS: "console" prints OTP to the log (dev only).
SMS_MODE=console

# LINE Login: "dev" accepts fake tokens "dev:<lineUserId>:<name>" (never in production).
LINE_AUTH_MODE=dev
LINE_LOGIN_CHANNEL_ID=
