{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:dev",
        "-w",
        "@serviceflow/api"
      ],
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@serviceflow/web"
      ],
      "port": 5173
    },
    {
      "name": "fs-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "field-service",
        "dev:api"
      ],
      "port": 4000
    },
    {
      "name": "fs-mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "field-service/apps/mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "fs-mobile-lan",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "field-service/apps/mobile",
        "exec",
        "expo",
        "start",
        "--lan",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "fs-admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "field-service/apps/admin",
        "exec",
        "next",
        "dev",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "fs-api-alt",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=field-service/.env",
        "field-service/apps/api/dist/main.js"
      ],
      "port": 4002,
      "env": {
        "PORT": "4002",
        "ADMIN_ORIGIN": "http://localhost:3002"
      }
    },
    {
      "name": "fs-admin-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "field-service/apps/admin",
        "exec",
        "next",
        "dev",
        "-p",
        "3002"
      ],
      "port": 3002,
      "env": {
        "NEXT_PUBLIC_API_URL": "http://localhost:4002",
        "NEXT_DIST_DIR": ".next-alt"
      }
    },
    {
      "name": "fs-mobile-web-qa",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "field-service/apps/mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "3102"
      ],
      "port": 3102,
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:4101"
      }
    },
    {
      "name": "fs-mobile-web-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "field-service/apps/mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "port": 8082,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-staging.koochang.com"
      }
    },
    {
      "name": "fs-mobile-metro",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "field-service/apps/mobile",
        "exec",
        "expo",
        "start",
        "--port",
        "8081"
      ],
      "port": 8081,
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:4000",
        "REACT_NATIVE_PACKAGER_HOSTNAME": "localhost"
      }
    },
    {
      "name": "fs-worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "field-service/apps/api",
        "dev:worker"
      ],
      "port": 4099
    }
  ]
}
