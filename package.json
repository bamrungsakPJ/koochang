{
  "name": "serviceflow",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @serviceflow/shared && npm run build -w @serviceflow/api",
    "dev:api": "npm run start:dev -w @serviceflow/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
