{
  "name": "@field-service/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --env-file=../../.env dist/main.js",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "dev:worker": "node --watch --env-file=../../.env dist/worker.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@expo-google-fonts/sarabun": "0.4.1",
    "@field-service/core": "workspace:*",
    "@field-service/i18n": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "mssql": "12.7.4",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@types/mssql": "12.3.0",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6"
  },
  "type": "module"
