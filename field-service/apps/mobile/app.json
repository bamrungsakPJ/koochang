{
  "expo": {
    "name": "คู่ช่าง",
    "slug": "koochang",
    "version": "0.2.3",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.koochang.app"
    },
    "android": {
      "package": "com.koochang.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#12243A"
      }
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ใช้ตำแหน่งเมื่อคุณกดใช้ตำแหน่งปัจจุบัน เพื่อบันทึกพิกัดสถานที่ลูกค้า / Used only when you tap Use current location to capture a customer's service location.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "ใช้กล้องเพื่อถ่ายรูปเครื่องและป้ายเครื่อง / Used to photograph equipment and nameplates.",
          "photosPermission": "เลือกรูปเครื่องจากคลังภาพ / Pick equipment photos from your library.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#12243A",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#12243A"
          }
        }
      ]
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "scheme": "koochang",
    "extra": {
      "eas": {
        "projectId": "b931694a-149d-4d2a-b1f6-cb89c7a03d8a"
      }
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
