# Local development examples only. Replace every password before use.
POSTGRES_PASSWORD=replace-owner-password
MIGRATION_DB_PASSWORD=replace-migration-password
API_DB_PASSWORD=replace-api-password
MIGRATION_DATABASE_URL=postgresql://fs_migrator:replace-migration-password@127.0.0.1:5432/field_service
DATABASE_URL=postgresql://fs_api:replace-api-password@127.0.0.1:5432/field_service
# Seed is local-only and requires the bootstrap role. Never use this in production API.
SEED_DATABASE_URL=postgresql://fs_owner:replace-owner-password@127.0.0.1:5432/field_service
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
ADMIN_ORIGIN=http://localhost:3001,http://localhost:8081
# A02 identity. Generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Missing or short secrets switch OTP / join links off (503) instead of using a default.
OTP_SECRET=replace-with-32-random-bytes-base64
JOIN_LINK_KEY=replace-with-32-random-bytes-base64
# Join links point here; the admin web serves /join/<token> and hands over to the app.
JOIN_LINK_BASE_URL=http://localhost:3001/join
# development = print codes to the API log, never allowed when NODE_ENV=production.
# No production SMS provider is chosen yet, so production OTP answers 503 until one is added.
SMS_PROVIDER=development
# Mobile app (Expo) and admin web reach the API here. On a phone use the dev machine's LAN/Tailscale address.
EXPO_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# A04 files and background work.
# Private directory for uploaded photos (not served publicly; include it in backups). Required in production.
MEDIA_DIR=.media
# HMAC key for 5-minute download links. Required in production.
MEDIA_URL_SECRET=replace-with-32-random-bytes-base64
# development = log only; no production OCR/push provider is chosen yet (production: OCR 503, push skipped).
OCR_PROVIDER=development
PUSH_PROVIDER=development
WORKER_DB_PASSWORD=replace-worker-password
WORKER_DATABASE_URL=postgresql://fs_worker:replace-worker-password@127.0.0.1:5432/field_service

# C01 platform console (separate role and sessions from the shop app). Without these the console answers 503.
PLATFORM_DB_PASSWORD=replace-platform-password
PLATFORM_DATABASE_URL=postgresql://fs_platform:replace-platform-password@127.0.0.1:5432/field_service
# 32 random bytes, base64: seals platform TOTP secrets.
PLATFORM_SECRET_KEY=replace-with-32-random-bytes-base64
# Receiving bank account shown on invoices; owners cannot create invoices until it is set (confirmed by the team).
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_PROMPTPAY_ID=
# EasySlip v2: register/link this receiver in the same EasySlip branch as the API key.
PAYMENT_BANK_CODE=
EASYSLIP_API_KEY=
# Trusted payment confirmation uses fs_worker, never fs_api/fs_platform/bootstrap credentials.
SLIP_DATABASE_URL=
